# Test Environment Configuration
NODE_ENV=test
PORT=5001
API_PREFIX=/api/v1
APP_NAME=ChatLock-Test
CORS_ORIGIN=*

MONGODB_URI=mongodb://localhost:27017/chatlock_test
MONGODB_DB_NAME=chatlock_test
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/15
REDIS_KEY_PREFIX=chatlock_test:
REDIS_TLS=false

JWT_ACCESS_SECRET=test_jwt_access_secret_min_32_characters_long_123
JWT_REFRESH_SECRET=test_jwt_refresh_secret_min_32_characters_long_123
JWT_ACCESS_EXPIRES_IN=5m
JWT_REFRESH_EXPIRES_IN=1d

SOCKET_PORT=5001
SOCKET_PATH=/socket.io
SOCKET_PING_TIMEOUT=5000
SOCKET_PING_INTERVAL=10000
SOCKET_CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads_test

BCRYPT_SALT_ROUNDS=4
SESSION_SECRET=test_session_secret_32_characters_long_key
HELMET_ENABLED=false

LOG_LEVEL=silent
LOG_PRETTY=false

ENABLE_VOICE_CALLS=false
ENABLE_END_TO_END_ENCRYPTION=false
ENABLE_MESSAGE_REACTIONS=true

EXPO_PUBLIC_API_URL=http://localhost:5001/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:5001
EXPO_PUBLIC_APP_ENV=test

{
  "name": "@chatlock/config",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized typed environment and configuration system for ChatLock",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile-env.d.ts",
      "import": "./dist/mobile-env.js",
      "require": "./dist/mobile-env.js"
    },
    "./server": {
      "types": "./dist/server-env.d.ts",
      "import": "./dist/server-env.js",
      "require": "./dist/server-env.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@chatlock/shared-types": "workspace:*",
    "dotenv": "^16.4.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}

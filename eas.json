{
  "cli": {
    "version": ">= 15.0.0",
    "appDir": "apps/mobile"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://chatlock-server.onrender.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://chatlock-server.onrender.com",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://chatlock-server.onrender.com/api/v1",
        "EXPO_PUBLIC_SOCKET_URL": "https://chatlock-server.onrender.com",
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

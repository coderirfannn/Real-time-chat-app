{
  "name": "@chatlock/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ChatLock Mobile Client (React Native + Expo)",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts*\"",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@chatlock/config": "workspace:*",
    "@chatlock/shared-types": "workspace:*",
    "@chatlock/validation": "workspace:*",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@types/react": "~18.3.12",
    "@types/react-native": "~0.73.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}

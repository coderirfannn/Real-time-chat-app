{
  "name": "@chatlock/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ChatLock Mobile Client (React Native + Expo)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts*\"",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@chatlock/config": "workspace:*",
    "@chatlock/shared-types": "workspace:*",
    "@chatlock/validation": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.6",
    "@types/react-native": "~0.73.0",
    "babel-preset-expo": "~54.0.12",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}

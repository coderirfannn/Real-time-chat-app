{
  "name": "@chatlock/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "ChatLock Mobile Client (React Native + Expo)",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts*\"",
    "lint:fix": "eslint \"src/**/*.ts*\" --fix",
    "test": "vitest run",
    "build": "tsc --noEmit",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@chatlock/config": "workspace:*",
    "@chatlock/shared-types": "workspace:*",
    "@chatlock/validation": "workspace:*",
    "@expo/metro-runtime": "~57.0.15",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "^57.0.17",
    "expo-linking": "^57.0.10",
    "expo-local-authentication": "^57.0.3",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.6",
    "babel-preset-expo": "~57.0.11",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
